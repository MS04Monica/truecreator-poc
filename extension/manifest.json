{
  "manifest_version": 3,
  "name": "TrueCreator Scan",
  "version": "1.0",
  "description": "Media authenticity and disclosure verification tool.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.vercel.app/*",
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}